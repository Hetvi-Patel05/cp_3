#include <stdio.h>

int main()
{
    int i, boys = 0, girls = 0;
    char sex;

    printf("Enter M for boy and F for girl:\n");

    for (i = 1; i <= 50; i++)
    {
        scanf(" %c", &sex);

        if (sex == 'M' || sex == 'm')
            boys++;
        else if (sex == 'F' || sex == 'f')
            girls++;
    }

    printf("Boys = %d\n", boys);
    printf("Girls = %d\n", girls);

    return 0;
}

#include <stdio.h>

int main()
{
    int n, i, a = 1, b = 1, c;

    printf("Enter the number of terms: ");
    scanf("%d", &n);

    printf("Fibonacci series:\n");

    for (i = 1; i <= n; i++)
    {
        if (i <= 2)
        {
            printf("1 ");
        }
        else
        {
            c = a + b;
            printf("%d ", c);

            a = b;
            b = c;
        }
    }

    return 0;
}

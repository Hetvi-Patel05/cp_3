#include <stdio.h>

int main()
{
    int n, square, temp, flag = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0)
    {
        printf("Please enter a non-negative number.");
        return 0;
    }

    square = n * n;
    temp = n;

    while (temp > 0)
    {
        if (temp % 10 != square % 10)
        {
            flag = 0;
            break;
        }

        temp = temp / 10;
        square = square / 10;
    }

    if (flag == 1)
        printf("%d is an automorphic number.", n);
    else
        printf("%d is not an automorphic number.", n);

    return 0;
}
